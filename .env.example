# Copy to `.env` and fill in values. Only `VITE_*` keys are exposed to the browser.

# Backend / API (no trailing slash). Leave empty if you only use static data for now.
VITE_API_BASE_URL=

# Shown in UI or document title when you wire it up
VITE_APP_NAME=Analytics Avenue

# Set to `true` for extra console logging in dev (read in app code when you add it)
VITE_DEBUG=false

# Supabase — Project Settings → API (use `anon` / publishable key, never service_role in the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
